#!/usr/bin/env bash
# git subtrees -- manage multiple git subtree prefixes with zero config.
#
# A "subtree" is implicitly any git remote whose name exactly equals the
# path of an existing directory in the worktree. There is no config file.
# The current local branch name doubles as the sync target on every
# subtree remote.
set -euo pipefail

real_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd "$(dirname "$real_path")" && pwd)"

# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
# shellcheck source=lib/init.sh
source "$script_dir/lib/init.sh"
# shellcheck source=lib/fetch.sh
source "$script_dir/lib/fetch.sh"
# shellcheck source=lib/pull.sh
source "$script_dir/lib/pull.sh"
# shellcheck source=lib/push.sh
source "$script_dir/lib/push.sh"
# shellcheck source=lib/status.sh
source "$script_dir/lib/status.sh"

top_usage() {
  cat <<'EOF'
usage: git subtrees <command> [<args>]

A subtree is any git remote whose name equals the path of an existing
worktree directory. There is no config file -- that mapping is the whole
contract. The current local branch name is the sync target on every
subtree remote.

Commands:
  init <path> <url>   one-time bootstrap: register a remote and add/adopt it
  fetch [path...]     fetch every subtree's remote (default: all)
  pull [path...]      squash-merge upstream changes into subtree paths
  push [path...]      push local subtree changes upstream
  status [path...]    show sync state of every remote

Run 'git subtrees <command> -h' for command-specific help.
EOF
}

main() {
  if [[ $# -eq 0 ]]; then
    top_usage >&2
    exit 1
  fi

  case "$1" in
    -h | --help)
      top_usage
      exit 0
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    fetch)
      shift
      cmd_fetch "$@"
      ;;
    pull)
      shift
      cmd_pull "$@"
      ;;
    push)
      shift
      cmd_push "$@"
      ;;
    status)
      shift
      cmd_status "$@"
      ;;
    *)
      log_err "unknown command: $1"
      top_usage >&2
      exit 1
      ;;
  esac
}

main "$@"
